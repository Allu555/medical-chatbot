# =============================================================================
# AI Medical Chatbot — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# Hugging Face token (required for gated models like MedGemma)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Model selection
BASE_MODEL_NAME=google/medgemma-4b-it
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Output directories (override defaults if needed)
OUTPUT_MODEL_DIR=artifacts/model
OUTPUT_CHECKPOINT_DIR=artifacts/checkpoints
FAISS_INDEX_DIR=artifacts/faiss
EVALUATION_DIR=artifacts/evaluation

# Training hyperparameters (override config defaults)
# TRAIN_BATCH_SIZE=2
# GRAD_ACCUM_STEPS=4
# MAX_SEQ_LEN=1024
# LORA_RANK=16
# NUM_EPOCHS=3

# Gradio settings
GRADIO_PORT=7860
GRADIO_SHARE=false

# RAG settings
RAG_TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=75
